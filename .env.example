# ===================================================
# SKINORA AI - ENVIRONMENT CONFIGURATION
# ===================================================

# Database Connection (PostgreSQL or SQLite)
# For PostgreSQL: postgresql://user:password@localhost:5432/skinora?schema=public
# For zero-config local SQLite: file:./dev.db
DATABASE_URL="file:./dev.db"

# Authentication & Security
JWT_SECRET="skinora_super_secret_jwt_key_development_2026_change_in_production"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Application Metadata
NEXT_PUBLIC_APP_NAME="SKINORA AI"
NEXT_PUBLIC_APP_TAGLINE="Know Before You Buy"

# Optional External AI API Key (Gemini Vision)
# If left empty, Skinora AI automatically runs in high-fidelity DEMO MODE (clearly labeled)
GEMINI_API_KEY=""

# Storage & Photo Uploads
# By default, Skinora AI runs zero-config on Vercel/Serverless using optimized Data URIs
# stored securely in the database, avoiding read-only filesystem issues.
# For high-volume persistent external cloud CDN storage, configure either:
#
# Option A: Cloudinary (Recommended for image optimization & CDN delivery)
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
# CLOUDINARY_UPLOAD_PRESET=""
# Or full URL:
# CLOUDINARY_URL=""
#
# Option B: Vercel Blob
# BLOB_READ_WRITE_TOKEN=""
#
# Local development only fallback:
UPLOAD_DIR="./public/uploads"
